' Five partial views of one system. Repeated C1-C4 are the same shared goals.
' All 14 original goals and permission conditions are preserved.

@startuml
!pragma layout smetana
left to right direction
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 28
skinparam actorStyle stickman
skinparam packageStyle rectangle
actor "Administrator" as Role
rectangle "TerraGuavd | Administration" {
 package "Role-specific goals" {
  usecase "Manage accounts\nand access" as A1
  usecase "View audit records\nand service health" as A2
 }
 package "Shared access within permissions" {
  usecase "Sign in / sign out" as C1
  usecase "View accessible mission\nrecords, maps and alerts" as C2
  usecase "View / download / print\npermitted mission reports" as C3
  usecase "View read-only live\n3D simulation" as C4
 }
}
Role -- A1
Role -- A2
Role -- C1
Role -- C2
Role -- C4
C3 ..> C2 : <<extend>>\n[report permission]
@enduml

